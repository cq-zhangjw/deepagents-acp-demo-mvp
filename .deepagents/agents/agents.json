            {
              "name": "upload_and_vectorize_document",
              "title": null,
              "description": "Upload a local document into a vector knowledge base and vectorize it.\n\nThe file is read from disk and sent to the MooFile upload endpoint, then\na vectorization task is started for it. When `wait` is True the tool polls\nthe task until it finishes and reports the final state and chunk count.",
              "inputSchema": {
                "additionalProperties": false,
                "properties": {
                  "local_path": {
                    "type": "string",
                    "description": "Absolute path of the document file on this machine.\nSupported extensions (parseable by the backend worker): .txt, .md,\n.markdown, .csv, .html, .htm, .json, .log."
                  },
                  "db_id": {
                    "type": "string",
                    "description": "The target knowledge base id; it must be a vector knowledge base."
                  },
                  "chunk_size": {
                    "default": 500,
                    "type": "integer",
                    "description": "Target chunk size in characters (100-2000, default 500)."
                  },
                  "overlap": {
                    "default": 20,
                    "type": "integer",
                    "description": "Chunk overlap in characters (0 <= overlap < chunk_size, default 20)."
                  },
                  "model": {
                    "default": "",
                    "type": "string",
                    "description": "Embedding model name; leave empty to use the knowledge base default."
                  },
                  "wait": {
                    "default": true,
                    "type": "boolean",
                    "description": "If True (default), block until the vectorization task completes."
                  },
                  "timeout": {
                    "default": 600.0,
                    "type": "number",
                    "description": "Max seconds to wait for the task (default 600)."
                  }
                },
                "required": [
                  "local_path",
                  "db_id"
                ],
                "type": "object"
              },
              "outputSchema": null,
              "icons": null,
              "annotations": null,
              "_meta": null,
              "execution": null
            },
