            {
              "name": "retrieve_knowledge",
              "title": null,
              "description": "Semantic search over a vector knowledge base (RAG retrieval).\n\nThe query is embedded with the knowledge base's configured model and the\nmost similar chunks are returned. Omitting top_k / threshold makes the\nbackend fall back to the knowledge base's vectorConfig defaults.",
              "inputSchema": {
                "additionalProperties": false,
                "properties": {
                  "db_id": {
                    "type": "string",
                    "description": "The vector knowledge base id."
                  },
                  "query": {
                    "type": "string",
                    "description": "The natural-language query text."
                  },
                  "top_k": {
                    "default": 0,
                    "type": "integer",
                    "description": "Max number of results (use 0 to fall back to the database\ndefault, normally 10)."
                  },
                  "threshold": {
                    "default": -1.0,
                    "type": "number",
                    "description": "Minimum similarity score to keep a result, 0-1\n(use -1 to fall back to the database default, normally 0.3)."
                  }
                },
                "required": [
                  "db_id",
                  "query"
                ],
                "type": "object"
              },
              "outputSchema": null,
              "icons": null,
