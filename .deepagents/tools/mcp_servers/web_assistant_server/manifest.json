    {
      "name": "baidu_search",
      "title": null,
      "description": "Search Baidu for a keyword and return the top-N results.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "keyword": {
            "type": "string",
            "description": "the search keyword / query string"
          },
          "num": {
            "default": 5,
            "type": "integer",
            "description": "how many results to return (1-20)"
          },
          "timeout": {
            "default": 15.0,
            "type": "number",
            "description": "request timeout in seconds"
          },
          "cookies": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "optional Cookie header string copied from a browser session,\ne.g. \"BAIDUID=xxx; BDUSS=yyy\". Baidu blocks cookie-less datacenter\nrequests with a captcha page; passing browser cookies bypasses it."
          }
        },
        "required": [
          "keyword"
        ]
      },
