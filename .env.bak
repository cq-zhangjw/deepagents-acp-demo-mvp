# [Common Settings]
PYTHONIOENCODING=utf-8
APP_ENV=pro

MODEL_PROVIDER=openai

TAVILY_API_KEY=-
TIMEOUT=300
MAX_RETRY=2

# [AI settings]
API_KEY=-
ENDPOINT=http://127.0.0.1:8088
MODEL_NAME=Ornith-1.5-9B
TEMPERATURE=1.0
TOP_P=0.95
MAX_TOKENS=10240
STREAM=true

# [App settings]
APP_HOST=0.0.0.0
APP_PORT=8000
DB_ROOT=./db
CONTENT_SIZE=32768
# Context window size (tokens), used by the frontend to show the context usage percentage. Adjust per your model.
UPLOAD_ROOT=./uploads
# Upload storage root (relative to project root or absolute). Ignored by git.

# TTS engine: genie (local ONNX, default) | edge_tts (Microsoft Edge online) | sapi (Windows voices)
TTS_ENGINE=edge_tts
# Fallback to Windows SAPI voices when the primary engine fails (true/false)
TTS_FALLBACK=true
# SAPI voice name fragments per language (empty = auto-pick by detected language)
SAPI_VOICE_ZH=
SAPI_VOICE_JA=
SAPI_VOICE_EN=
# SAPI speaking speed multiplier (1.0 = normal, 1.3 = 30% faster)
SAPI_SPEAK_RATE=1.3
# TTS playback mode: stream (low first-chunk latency) | file (non-streaming, play after full audio)
TTS_MODE=stream
# Stream chunk frames (sentence-level streaming; kept for compatibility)
TTS_STREAM_CHUNK_FRAMES=48
# genie-tts: preset voices exposed to the frontend (zh/en/jp/auto; auto = mixed output)
# GENIE_DATA_DIR optional override; default = models/xnnehanglab-geniedata under project root
# edge_tts engine: default voices per language (Microsoft Edge online voices)
EDGE_TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
EDGE_TTS_VOICE_JA=ja-JP-NanamiNeural
EDGE_TTS_VOICE_EN=en-US-AriaNeural
# edge_tts speaking speed multiplier (1.0 = normal, 1.3 = 30% faster); overrides EDGE_TTS_RATE when set
EDGE_TTS_SPEAK_RATE=1.3
# edge_tts prosody (optional, e.g. "+10%", "+0Hz")
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz
# edge_tts http(s) proxy for restricted networks (empty = system default)
EDGE_TTS_PROXY=

# History persistence root (MooFile BSON collections; default = ./db/history)
HISTORY_ROOT=./db/db_history_a83f7f6f
# Knowledge base (MooFile Base integration, REST on :8888; empty base URL disables the feature)
MOOFILE_BASE_URL=http://127.0.0.1:8888
# top-k chunks pre-fetched per enabled database
MOOFILE_RETRIEVAL_TOP_K=5
# similarity threshold (empty = use the database's own vector-config threshold)
MOOFILE_RETRIEVAL_THRESHOLD=0.3
# per-request timeout in seconds
MOOFILE_TIMEOUT=3
# knowledge-server MCP tool HTTP request timeout in seconds (default 120)
MOOFILE_API_TIMEOUT=120
# Root directory of the external moofile_base project (absolute, or relative to this project); empty = sibling directory
MOOFILE_BASE_ROOT_DIR=../moofile_base
MOOFILE_MCP_TRANSPORT=stdio

# Context compaction: auto-compact session history when estimated tokens reach CONTENT_SIZE * RATIO (0.85 = 85%)
CONTEXT_COMPACT_RATIO=0.85
# Extra estimated tokens not covered by the message text estimator (system prompt, tool schemas, images)
CONTEXT_COMPACT_OVERHEAD=6000
# Max tokens the summarizer may produce for the compacted summary
CONTEXT_COMPACT_SUMMARY_MAX_TOKENS=2048
# Keep the most recent N messages untouched; only earlier ones are summarized and removed
CONTEXT_COMPACT_KEEP_RECENT=8
# Summarizer input guard: at most this fraction of the window (chars) is sent to the model for summarizing
CONTEXT_COMPACT_SUMMARY_INPUT_FRACTION=0.6

OPEN_BROWSER=1